{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Get Better at Chess",
  "version": "0.0.0",
  "identifier": "app.getbetteratchess.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @gbc/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @gbc/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Get Better at Chess",
        "width": 1000,
        "height": 900,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
